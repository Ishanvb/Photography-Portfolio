# ---------------------------------------------------------------- Supabase ---
# Project settings -> API. The service-role key bypasses row-level security and
# must never be exposed to the browser: keep the name un-prefixed so Vite cannot
# inline it into the client bundle.
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=photos

# ----------------------------------------------------------------- Session ---
# Signs the admin session cookie. 32+ random characters:
#   openssl rand -base64 48
SESSION_SECRET=

# -------------------------------------------------------------- Passkeys -----
# RP_ID is the bare domain (no scheme, no port). RP_ORIGIN is the full origin.
# These MUST match the domain the admin page is served from or passkeys silently
# fail to verify.
RP_ID=your-domain.com
RP_ORIGIN=https://your-domain.com
RP_NAME=Mari Parzick Photography
ADMIN_USERNAME=mari

# ---------------------------------------------------------------- Bootstrap ---
# Enrols the FIRST passkey, and only works while zero credentials exist — it is
# inert the moment setup is finished. Generate with:
#   openssl rand -hex 24
ADMIN_BOOTSTRAP_TOKEN=
